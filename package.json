{
  "name": "wrightplay",
  "description": "playwright, but unit test",
  "version": "0.1.0",
  "type": "module",
  "main": "./build/client/api.js",
  "types": "./build/client/api.d.ts",
  "exports": {
    ".": "./build/client/api.js",
    "./cli": "./build/cli/api.js",
    "./node": "./build/server/api.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "<4.7": {
      ".": [
        "./build/client/api.d.ts"
      ],
      "cli": [
        "./build/cli/api.d.ts"
      ],
      "node": [
        "./build/server/api.d.ts"
      ]
    }
  },
  "bin": {
    "wrightplay": "./build/cli/index.js"
  },
  "browser": {
    "mocha": "mocha/mocha.js",
    "process": "process/browser.js",
    "jest-message-util": false,
    "jest-util": false
  },
  "author": "PaperStrike",
  "repository": "github:PaperStrike/wrightplay",
  "license": "ISC",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "prepare": "pnpm build",
    "cli": "tsx src/cli/index.ts",
    "test-entry": "pnpm cli -- ww=test/entry/worker.ts test/entry/*.test.*",
    "test-handle": "pnpm cli -- test/handle/*.test.*",
    "test-route": "pnpm cli -- test/route/*.test.*",
    "test": "pnpm cli -- ww=test/entry/worker.ts test/**/*.test.ts !**/third-party",
    "test-chromium": "pnpm test -- --browser chromium",
    "test-firefox": "pnpm test -- --browser firefox",
    "test-webkit": "pnpm test -- --browser webkit",
    "report-coverage": "c8 -a report"
  },
  "files": [
    "build",
    "static",
    "src",
    "!*.tsbuildinfo"
  ],
  "keywords": [
    "test",
    "unit",
    "mock",
    "testing",
    "playwright",
    "coverage",
    "v8"
  ],
  "dependencies": {
    "@commander-js/extra-typings": "^11.1.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "esbuild": "~0.19.12",
    "get-port": "^7.0.0",
    "glob-parent": "^6.0.2",
    "globby": "^14.0.0",
    "jiti": "^1.21.0",
    "lilconfig": "^3.0.0",
    "mrmime": "^2.0.0",
    "playwright": "^1.41.1",
    "sirv": "^2.0.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@eslint/markdown": "^7.5.1",
    "@stylistic/eslint-plugin": "^5.6.0",
    "@types/glob-parent": "^5.1.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.25",
    "@types/tape": "^5.8.1",
    "@types/ws": "^8.18.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "eslint-config-ts-parser-service": "^1.0.1",
    "eslint-plugin-import": "^2.32.0",
    "events": "^3.3.0",
    "expect": "^28.1.3",
    "mocha": "^11.7.5",
    "path": "^0.12.7",
    "stream": "^0.0.3",
    "tape": "^5.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "uvu": "^0.5.6",
    "zora": "^6.0.0"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
